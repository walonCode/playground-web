# Copy to .env.local for local development. On Vercel, set these in the project's
# Environment Variables instead — .env.local is never deployed.

# --- Production (set these in the Vercel dashboard) -------------------------

# Backend origin, reached server-side by the /api proxy in next.config.ts. HTTP
# is fine here: the browser never touches it, so there is no mixed-content
# problem and the box needs no TLS certificate.
#   API_ORIGIN=http://<elastic-ip>:3001

# The deployed site origin, used for page metadata and for the absolute URL in
# the copyable curl commands. No trailing slash.
#   NEXT_PUBLIC_SITE_URL=https://glassbox.vercel.app

# --- Local development ------------------------------------------------------

# Point the browser straight at the gateway and skip the proxy. Leave this
# UNSET in production so the app uses the same-origin /api proxy instead.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
