# Copy to .env.local for local development. On Vercel, set these in the project's
# Environment Variables instead — .env.local is never deployed.

# --- Production (set these in the Vercel dashboard) -------------------------

# Backend origin, reached server-side by the /api proxy in next.config.ts. HTTP
# is fine here: the browser never touches it, so there is no mixed-content
# problem and the box needs no TLS certificate.
#   API_ORIGIN=http://<elastic-ip>:3001

# The deployed site origin, used for page metadata and for the absolute URL in
# the copyable curl commands. No trailing slash.
#   NEXT_PUBLIC_SITE_URL=https://glassbox.vercel.app

# The chat WebSocket, pointed straight at the backend — Vercel's serverless
# layer cannot proxy a WS upgrade, so this bypasses the /api proxy. Needs wss://
# (TLS on the box) in production, since the page is served over HTTPS.
#   NEXT_PUBLIC_CHAT_WS_URL=wss://api.glassbox.example/ws

# --- Auth (Better Auth, hosted HERE not on the box) ------------------------
# Identity deliberately does not live on EC2: signing in has to work while the
# instance is stopped, and you cannot require a running box to log in to the
# thing that starts the box. This app issues the JWT; the box re-verifies it
# against /api/auth/jwks served from here.

# Always-on Postgres for accounts. Neon in production; any Postgres locally.
#   AUTH_DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# openssl rand -base64 32
#   BETTER_AUTH_SECRET=replace-me

# Optional social sign-in — each provider is registered only when both values
# are present, so an unconfigured provider is simply not offered.
#   GITHUB_CLIENT_ID=
#   GITHUB_CLIENT_SECRET=
#   GOOGLE_CLIENT_ID=
#   GOOGLE_CLIENT_SECRET=

# --- Wake / sleep (start-stop the EC2 box) ---------------------------------
# All optional. With none set, the control still works end to end: state is
# kept in-process and the AWS calls are dry-run (logged, not made). Set these to
# make it real — that is the only remaining step.

# Shared state, so the wake/sleep machine survives across serverless
# invocations. REQUIRED in production; local dev falls back to in-memory.
#   UPSTASH_REDIS_REST_URL=https://<name>.upstash.io
#   UPSTASH_REDIS_REST_TOKEN=...

# The one instance this may start and stop, and where it lives.
#   EC2_INSTANCE_ID=i-0123456789abcdef0
#   AWS_REGION=eu-west-1

# Credentials for the scoped IAM user (see DEPLOY.md for the policy).
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...

# The safety catch. Until this is exactly "true", StartInstances/StopInstances
# are never called, even with everything above set.
#   AWS_LIVE=true

# Protects the scheduled sleep route. Vercel sends it as a bearer token.
#   CRON_SECRET=...

# Tuning (optional): idle threshold and how soon after a wake to health-check.
#   DEMO_IDLE_MS=1500000
#   DEMO_MIN_WAKE_MS=60000

# --- Local development ------------------------------------------------------

# Point the browser straight at the gateway and skip the proxy. Leave this
# UNSET in production so the app uses the same-origin /api proxy instead.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
